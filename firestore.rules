rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is the user authenticated?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Is the user the owner of the document (by UID or Path)?
    function isMember(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper: Check if fields being updated are limited to 'friendsList'
    function isOnlyFriendsUpdate() {
      // In firestore rules, diff() returns a MapDiff object
      // We check if only 'friendsList' is being changed
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendsList']);
    }

    // Helper: Ensure user is only adding themselves as a friend
    function isAddingSelfAsFriend() {
      return request.resource.data.friendsList.hasAll(resource.data.friendsList) &&
             request.resource.data.friendsList.size() == resource.data.friendsList.size() + 1 &&
             request.resource.data.friendsList.hasAny([request.auth.uid]);
    }

    // Helper: Validate transaction data types and values
    function isValidTransaction() {
      return request.resource.data.amount is number && 
             request.resource.data.amount >= 0 &&
             request.resource.data.description is string && 
             request.resource.data.description.size() > 0;
    }

    // --- USERS ---
    // • Get: Needed for profile display
    // • List: Limited to 10 results to prevent scraping
    // • Create: Only the user themselves
    // • Update: User themselves OR someone updating your friendsList
    match /users/{userId} {
      allow get: if isSignedIn(); 
      allow list: if isSignedIn() && request.query.limit <= 10;
      allow create: if isMember(userId);
      allow update: if isMember(userId) || (isSignedIn() && isOnlyFriendsUpdate() && isAddingSelfAsFriend());
      allow delete: if false;
    }

    // --- TRANSACTIONS ---
    // • Access strictly limited to participants (payer or debtor)
    // • Strict role-based enforcement for creation, modification, and deletion
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && 
        (resource.data.payerId == request.auth.uid || resource.data.debtorId == request.auth.uid);
      
      allow create: if isSignedIn() && 
        request.resource.data.payerId == request.auth.uid && isValidTransaction();

      allow update: if isSignedIn() && (
        resource.data.payerId == request.auth.uid || 
        (resource.data.debtorId == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settleStatus']))
      ) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount', 'description']) || isValidTransaction());

      allow delete: if isSignedIn() && 
        resource.data.payerId == request.auth.uid;
    }

    // --- JOURNAL ---
    // • Access strictly limited to the owner
    match /journal/{journalId} {
      allow read, update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid &&
        request.resource.data.amount is number && request.resource.data.amount >= 0 && 
        request.resource.data.description is string;
    }

    // --- FRIEND REQUESTS ---
    // • Sender and Receiver can read/delete
    // • Sender can create
    // • Receiver can update (accept/decline) - Restricted to status field only
    match /friend_requests/{requestId} {
      allow read, delete: if isSignedIn() && 
        (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.toId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    // --- SHOPPING LIST ---
    // • Access strictly limited to the owner
    match /shopping_list/{itemId} {
      allow read, update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // --- GLOBAL DENY ---
    // Deny all by default for any other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

