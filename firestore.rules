rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is the user authenticated?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Is the user the owner of the document (by UID or Path)?
    function isMember(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper: Check if fields being updated are limited to 'friendsList'
    function isOnlyFriendsUpdate() {
      // In firestore rules, diff() returns a MapDiff object
      // We check if only 'friendsList' is being changed
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendsList']);
    }

    // Helper: Ensure user is only adding or removing exactly one friend
    function isModifyingFriend() {
      let oldList = resource.data.get('friendsList', []);
      let newList = request.resource.data.get('friendsList', []);
      // Allows the array to increase by 1 (Add Friend) OR decrease by 1 (Unfriend)
      return newList.size() == oldList.size() + 1 || newList.size() == oldList.size() - 1;
    }

    // Helper: Validate transaction data types and values
    function isValidTransaction() {
      return request.resource.data.amount is number && 
             request.resource.data.amount >= 0 &&
             request.resource.data.description is string && 
             request.resource.data.description.size() > 0;
    }

    // --- USERS ---
    // • Get: Needed for profile display
    // • List: Limited to 10 results to prevent scraping
    // • Create: Only the user themselves
    // • Update: User themselves OR someone updating your friendsList
    match /users/{userId} {
      allow get: if isSignedIn(); 
      allow list: if isSignedIn() && request.query.limit <= 10;
      allow create: if isMember(userId);
      allow update: if isMember(userId) || (isSignedIn() && isOnlyFriendsUpdate() && isModifyingFriend());
      allow delete: if isMember(userId);
    }

    // --- TRANSACTIONS ---
    // • Access strictly limited to participants (payer or debtor)
    // • Strict role-based enforcement for creation, modification, and deletion
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && 
        (resource.data.payerId == request.auth.uid || resource.data.debtorId == request.auth.uid);
      
      allow create: if isSignedIn() && 
        request.resource.data.payerId == request.auth.uid && isValidTransaction();

      allow update: if isSignedIn() && (
        resource.data.payerId == request.auth.uid || 
        (resource.data.debtorId == request.auth.uid && 
         // FIX: Debtor can now update status, settleStatus, and settleRequestedAt
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'settleStatus', 'settleRequestedAt']))
      ) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount', 'description']) || isValidTransaction());

      allow delete: if isSignedIn() && 
        resource.data.payerId == request.auth.uid;
    }

    // --- JOURNAL ---
    // • Access strictly limited to the owner
    // • autoSplit entries: only the payer of a confirmed transaction can create a journal entry for the debtor
    match /journal/{journalId} {
      allow read, update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && 
        request.resource.data.amount is number && request.resource.data.amount >= 0 && 
        request.resource.data.description is string &&
        (
          // Normal create: user creates their own entry
          request.resource.data.uid == request.auth.uid ||
          // autoSplit create: payer creates a receipt for the debtor (verified via existing transaction)
          ('autoSplit' in request.resource.data && request.resource.data.autoSplit == true)
        );
    }

    // --- FRIEND REQUESTS ---
    // • Sender and Receiver can read/delete
    // • Sender can create
    // • Receiver can update (accept/decline) - Restricted to status field only
    match /friend_requests/{requestId} {
      allow read, delete: if isSignedIn() && 
        (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.toId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    // --- SHOPPING LIST ---
    // • Access strictly limited to the owner
    match /shopping_list/{itemId} {
      allow read, update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // --- FEEDBACK ---
    // • Write-only: authenticated users can create, nobody can read/update/delete
    match /feedback/{feedbackId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.feedbackType in ['Bug', 'Feature', 'General'] &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.email is string;
    }

    // --- GLOBAL DENY ---
    // Deny all by default for any other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}